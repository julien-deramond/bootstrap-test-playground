{
  "name": "bootstrap-test-playground",
  "version": "0.0.0",
  "private": true,
  "description": "A Vite multi-page playground to test and reproduce issues with Bootstrap v6 (v6-dev branch).",
  "license": "MIT",
  "author": "Julien Déramond",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:visual": "playwright test --project visual",
    "test:visual:engines": "playwright test --project \"visual*\"",
    "test:console": "playwright test --project console",
    "test:console:engines": "playwright test --project \"console*\"",
    "test-scope": "node scripts/test-scope.mjs",
    "test:smoke": "playwright test --project smoke",
    "test:smoke:engines": "playwright test --project \"smoke*\"",
    "lint:html": "node scripts/lint-html.mjs",
    "check-configs": "node scripts/check-configs.mjs",
    "check-dist": "node scripts/check-dist.mjs",
    "audit-tokens": "node scripts/audit-tokens.mjs",
    "compile-matrix": "node scripts/compile-matrix.mjs",
    "check-size": "node scripts/check-size.mjs",
    "audit-rtl": "node scripts/audit-rtl.mjs",
    "audit-motion": "node scripts/audit-motion.mjs",
    "audit-layers": "node scripts/audit-layers.mjs",
    "audit-partials": "node scripts/audit-partials.mjs",
    "new-issue": "node scripts/new-issue.mjs",
    "save-config": "node scripts/save-config.mjs",
    "use-config": "node scripts/use-config.mjs",
    "configs-table": "node scripts/configs-table.mjs",
    "sync-kitchen-sink": "node scripts/sync-kitchen-sink.mjs",
    "canary-report": "node scripts/canary-report.mjs",
    "diff-bootstrap": "node scripts/diff-bootstrap.mjs",
    "update-bootstrap": "node scripts/update-bootstrap.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "bootstrap": "github:twbs/bootstrap#v6-dev",
    "vanilla-calendar-pro": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "autoprefixer": "^10.6.1",
    "html-validate": "^11.16.0",
    "postcss-prefix-custom-properties": "^0.1.0",
    "sass-embedded": "^1.105.0",
    "vite": "^8.3.1"
  }
}
