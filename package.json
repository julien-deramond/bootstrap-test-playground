{
  "name": "bootstrap-test-playground",
  "version": "0.0.0",
  "private": true,
  "description": "A Vite multi-page playground to test and reproduce issues with Bootstrap v6 (the main branch of twbs/bootstrap).",
  "license": "MIT",
  "author": "Julien Déramond",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node scripts/check.mjs",
    "check:full": "node scripts/check.mjs --full",
    "test": "node --test scripts/__tests__/*.test.mjs",
    "test:visual": "playwright test --project visual",
    "test:visual:engines": "playwright test --project \"visual*\"",
    "test:console": "playwright test --project console",
    "test:console:engines": "playwright test --project \"console*\"",
    "test:a11y": "playwright test --project a11y",
    "a11y-summary": "node scripts/a11y-summary.mjs",
    "report:contrast": "node scripts/report-contrast.mjs",
    "test-scope": "node scripts/test-scope.mjs",
    "prune-baselines": "node scripts/prune-baselines.mjs",
    "test:smoke": "playwright test --project smoke",
    "test:smoke:engines": "playwright test --project \"smoke*\"",
    "test:issues": "playwright test --project issues",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:format",
    "lint:js": "eslint --report-unused-disable-directives .",
    "lint:css": "stylelint \"**/*.{css,scss}\"",
    "lint:format": "prettier --check \"pages/**/*.html\" \"screens/*.html\"",
    "lint:fix": "eslint --fix . && stylelint --fix \"**/*.{css,scss}\" && prettier --write \"pages/**/*.html\" \"screens/*.html\"",
    "lint:html": "node scripts/lint-html.mjs",
    "check-configs": "node scripts/check-configs.mjs",
    "check-dist": "node scripts/check-dist.mjs",
    "check-equivalence": "node scripts/check-equivalence.mjs",
    "audit-tokens": "node scripts/audit-tokens.mjs",
    "compile-matrix": "node scripts/compile-matrix.mjs",
    "matrix": "node scripts/matrix.mjs",
    "check-size": "node scripts/check-size.mjs",
    "audit-rtl": "node scripts/audit-rtl.mjs",
    "audit-motion": "node scripts/audit-motion.mjs",
    "audit-layers": "node scripts/audit-layers.mjs",
    "audit-partials": "node scripts/audit-partials.mjs",
    "audit-themes": "node scripts/audit-themes.mjs",
    "new-issue": "node scripts/new-issue.mjs",
    "save-config": "node scripts/save-config.mjs",
    "use-config": "node scripts/use-config.mjs",
    "configs-table": "node scripts/configs-table.mjs",
    "sync-kitchen-sink": "node scripts/sync-kitchen-sink.mjs",
    "canary-report": "node scripts/canary-report.mjs",
    "diff-bootstrap": "node scripts/diff-bootstrap.mjs",
    "update-bootstrap": "node scripts/update-bootstrap.mjs",
    "record-update": "node scripts/record-update.mjs",
    "status-sweep": "node scripts/status-sweep.mjs",
    "import-issue": "node scripts/import-issue.mjs",
    "check-issues": "node scripts/check-issues.mjs",
    "export-issue": "node scripts/export-issue.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "bootstrap": "github:twbs/bootstrap#main",
    "vanilla-calendar-pro": "^3.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "autoprefixer": "^10.6.1",
    "bootstrap-icons": "^1.13.2",
    "eslint": "^10.14.0",
    "eslint-config-xo": "^0.53.2",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-unicorn": "^68.0.0",
    "globals": "^17.13.0",
    "globby": "^16.2.4",
    "html-validate": "^11.17.0",
    "parse5": "^8.0.1",
    "postcss-cli": "^12.0.0",
    "postcss-prefix-custom-properties": "^0.1.0",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.106.1",
    "stylelint": "^16.26.1",
    "stylelint-config-twbs-bootstrap": "^16.1.0",
    "stylelint-order": "^8.1.2",
    "terser": "^5.51.2",
    "vite": "^8.3.5"
  }
}
